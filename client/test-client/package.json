{
  "name": "@stratofold/client-test-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Frontend-only manual and E2E test client for @stratofold/client",
  "scripts": {
    "dev": "npm run build:package && vite",
    "build": "tsc --noEmit && vite build",
    "build:package": "npm --prefix .. run build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@stratofold/client": "file:.."
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.6.4",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
