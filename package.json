{
  "name": "stratofold",
  "version": "0.1.0",
  "description": "Stratofold — a cloud file manager",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mode777/stratofold.git"
  },
  "license": "ISC",
  "type": "commonjs",
  "scripts": {
    "web": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:test": "npm --prefix web run test",
    "web:e2e": "npm --prefix web run e2e",
    "client:build": "npm --prefix client run build",
    "client:test": "npm --prefix client run test && npm --prefix client/test-client run test",
    "client:e2e": "npm --prefix client/test-client run e2e",
    "client:pages:build": "npm --prefix client run build && SF_CLIENT_BASE=/stratofold/ npm --prefix client/test-client run build"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.13.1"
  }
}
